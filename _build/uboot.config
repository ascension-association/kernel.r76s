# Appended to nanopi-r76s-rk3576_defconfig.
# gokrazy copies *.dtb to the root of the boot partition, so load the device
# tree from /rk3576-nanopi-r76s.dtb (U-Boot's EFI bootmeth tries /<fdtfile>)
# instead of the U-Boot built-in one; this keeps the device tree in sync with
# the kernel.
CONFIG_DEFAULT_FDT_FILE="rk3576-nanopi-r76s.dtb"
